# Dev-only data / corpora not needed to build or run the app in production.
# (data/ is intentionally NOT ignored — data/tambour-colors.json is imported at build.)
floorplan-gt/
floorplan_for_training/
eval/
eval-out/
out/
docs/
scripts/
*.tsbuildinfo

# Real IKEA .glb models (~400 MB) are served from Vercel Blob, not bundled — the
# catalog references them by URL (data/furniture-ikea.blob.json). Keep them out of
# the deployment upload. Transparent thumbnails under .../thumb/ ARE shipped.
public/furniture/ikea/*.glb

# BlenderKit RAW downloads (~412 MB). The optimized copies under opt/ and the
# picker thumbnails under thumb/ ARE shipped — the glob stops at the directory
# boundary, so only the top-level raw files are excluded here.
public/furniture/blenderkit/*.glb

# The KTX2 re-encode (124 MB), held out of production 2026-08-31 — see the
# MODEL_BASE comment in scripts/blenderkit/build-catalog.ts for why. The
# catalog points at opt/, so uploading these would be 124 MB of dead weight on
# every deploy. WHEN KTX2 SHIPS, DELETE THIS RULE: leaving it while MODEL_BASE
# points at opt-ktx2 would 404 all 75 models. `npm run furniture:verify-deploy`
# fails loudly on exactly that combination, so the mistake is caught, not
# discovered in production.
public/furniture/blenderkit/opt-ktx2/

# Regenerable IKEA raw API cache — never needed at build/runtime.
data/raw/

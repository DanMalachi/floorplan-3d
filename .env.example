# Copy to .env.local and fill in. Most vars here are optional — the app runs
# without them, it just loses the feature each one powers. The exceptions are
# marked REQUIRED IN PRODUCTION: without those, the endpoint they cover refuses to
# serve rather than serving insecurely.

# ---- Accounts + cloud projects (Supabase) -----------------------------------
# Without these the app is guest-only: projects stay in this browser's IndexedDB
# and the account control doesn't render. Project settings → Data API in the
# Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Account deletion + retention sweep (SECRETS — server only) --------------
# SUPABASE_SERVICE_ROLE_KEY bypasses EVERY row-level-security policy in the
# project: anyone holding it can read or delete every account's plans. It has no
# NEXT_PUBLIC_ prefix precisely so Next never inlines it into a browser bundle,
# and only src/lib/supabase/admin.ts reads it. Never paste it into client code, a
# NEXT_PUBLIC_ var, or a committed file. Project settings → API keys → service_role.
# Without it, /account hides the delete button rather than half-deleting.
SUPABASE_SERVICE_ROLE_KEY=

# Authorises the scheduled retention sweep (GET /api/account/retention). Vercel
# Cron sends it automatically as `Authorization: Bearer $CRON_SECRET` once it is
# set on the project. Unset = the endpoint refuses to run at all, since it
# deletes data. Any long random string — `openssl rand -base64 32`.
CRON_SECRET=

# Retention windows, both optional (defaults shown). See docs/DATA_RETENTION.md.
#   PURGE: how long a deleted plan's tombstone + files survive, so the deletion
#          can propagate to the user's other devices before the data is gone.
#   ORPHAN GRACE: how old an unreferenced file must be before the sweep treats it
#          as an orphan. Must comfortably exceed a slow upload, because the image
#          is uploaded BEFORE the row that references it is written.
RETENTION_PURGE_DAYS=30
RETENTION_ORPHAN_GRACE_HOURS=48

# ---- Live collaboration (Liveblocks) ----------------------------------------
# Server-side secret. Unset: /api/liveblocks-auth returns 503 and live rooms are
# unavailable.
LIVEBLOCKS_SECRET_KEY=

# Signs share links AND the room-ownership cookie (src/collab/grant.server.ts).
# Any long random string — `openssl rand -base64 32`. Falls back to
# LIVEBLOCKS_SECRET_KEY when unset; once set, links signed with the old key still
# verify.
#
# REQUIRED IN PRODUCTION (this or LIVEBLOCKS_SECRET_KEY). The source used to carry
# a hardcoded fallback secret, so anyone who read the repo could forge a "build"
# grant for any room on a deployment that had set neither variable. That fallback
# is gone: production with neither set now fails closed, and /api/share and
# /api/liveblocks-auth return 503 instead of signing with a public value.
SHARE_SIGNING_SECRET=

# Escape hatch for rooms created before server-side ownership existed, and ONLY
# for a deployment with no Supabase configured. "true" lets a browser claim an old
# 8-character room id first-come-first-served. Off by default because those ids
# are 32 bits and enumerable. With Supabase configured, don't use this — sign in
# and open the room, which claims it properly and permanently.
SHARE_LEGACY_ROOM_CLAIM=

# ---- Rate limiting (Upstash Redis) ------------------------------------------
# In-memory rate limiting does nothing useful on Vercel: each request may land on
# a fresh instance, so a per-instance counter caps nothing an attacker cares
# about. These point at Upstash's REST API — no dependency, it is plain fetch.
# Upstash console → your database → REST API.
#
# REQUIRED IN PRODUCTION for the endpoints that spend money or spawn a process
# (/api/classify, /api/classify-rooms, /api/extract, /api/propose-raster,
# /api/dwg2dxf): without them those return 503, deliberately — an unlimited LLM
# proxy on Dan's key is worse than a closed one. The cheap endpoints (/api/share,
# /api/liveblocks-auth) instead fall back to per-instance limiting and log a
# warning, rather than taking the whole app down when Upstash isn't provisioned.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Room naming (Anthropic) ------------------------------------------------
# RETIRED 2026-08-23. /api/classify-rooms and /api/classify were removed, so the
# app no longer calls Anthropic and needs no key to run. Kept documented only
# because the legacy eval scripts under legacy/scripts/ still read this when run
# by hand against the local corpus. Production does not.
ANTHROPIC_API_KEY=

# ---- Furniture model hosting (Vercel Blob) ----------------------------------
# Build-time only, for `npm run ikea:upload`. Not needed to run the app.
BLOB_READ_WRITE_TOKEN=

# ---- Local tooling ----------------------------------------------------------
# /api/extract, /api/propose-raster and /api/dwg2dxf shell out to a program on the
# host machine. They are DISABLED unless this is exactly "true", and they also
# require a signed-in account. Never set it on a deployment that doesn't have the
# tools installed — including Vercel, where none of them exist.
#
# This is what turns DWG import back on for local use. It has never worked on
# Vercel (no converter there), so the flag costs production nothing.
LOCAL_TOOLS_ENABLED=

# Full path to the executables those routes spawn. No fallback and no
# auto-detection: unset gives a clean 503 naming the variable to set. A hardcoded
# C:\Users\dandu\...\python.exe used to stand in here — one machine's layout baked
# into the product, which "worked" there and failed inscrutably everywhere else.
ODA_CONVERTER_EXE=
PYTHON_EXE=

# ---- Request size caps ------------------------------------------------------
# Bytes, both optional. Defaults: 25 MB uploads, 12 MB for the LLM payloads. A
# body over the cap is refused before it is read into memory.
MAX_UPLOAD_BYTES=
CLASSIFY_MAX_BODY_BYTES=

# ---- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_LEGACY_EXTRACTION_ENABLED=
NEXT_PUBLIC_KTX2_FLOORS_ENABLED=

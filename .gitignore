# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# phase 2.5 eval harness outputs
/eval-out/

# python bytecode (scrapers / eval scripts)
__pycache__/
*.pyc

# CAD import fixtures — large .dwg binaries + generated .dxf conversions; keep
# these local only, out of git history
floorplan_for_training/dxf_dwg/

# Phase 1 baselines — CubiCasa5K dataset/weights/vendored repo (5.5GB+
# zip, not ours to redistribute) and generated baseline predictions/HTML
# reports (regenerable via extraction/baselines/*.py + summarize.py).
/data/cubicasa5k/
/data/baselines_out/
/reports/phase-1/

# Catalog pipeline raw cache — regenerable intermediate (raw API responses +
# HTTP cache). Committed static asset: the catalog JSON data/furniture-*.json.
/data/raw/

# BlenderKit raw downloads (~412 MB of undecimated archviz .glb with 4K textures).
# Regenerable with `npm run bk:models`. Only the OPTIMIZED copies under opt/ are
# committed and served — 75 files, ~20 MB after Draco + WebP, small enough that
# keeping them in git makes a deploy reproducible from a clean checkout.
/public/furniture/blenderkit/*.glb

# .blend and alternate-export downloads that `recover-blend-textures.ts` carves
# the missing maps out of (~10 MB). Same principle as the raw .glb set above:
# re-fetchable from BlenderKit, and only the optimized output is committed.
/scripts/blenderkit/.scratch/

# ambientCG intermediate JPEGs (~38 MB) unpacked from the source zips. The
# committed artifact is the repacked WebP under public/materials/.
# Regenerable with `npm run mat:fetch`.
/scripts/materials/.raw/

# Same reasoning, M3c's ingest source directories: raw ambientCG JPEGs plus
# their asset.json descriptors. Regenerable with `npm run mat:ingest:fetch-m3c`.
/scripts/materials/ingest/.sources/

.vercel
.venv

# per-agent incremental build info (parallel typechecks would race on the
# single tsconfig.tsbuildinfo; each run gets its own via --tsBuildInfoFile)
.tsbuildinfo.*

# Scratch: per-worker i18n fragments, merged into messages/*.json by
# scripts/i18n/merge-fragments.mjs. Never the source of truth.
.i18n-fragments/
